{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "CategoryBudget": {
      "title": "CategoryBudget",
      "description": "Monthly spending budget and threshold warning per category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 128 },
        "monthlyLimit": { "type": "number" },
        "warningThresholdPercent": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string" }
      },
      "required": ["category", "monthlyLimit", "userId"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "A ledger transaction entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vendor": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 512 },
        "memo": { "type": "string", "maxLength": 512 },
        "category": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "account": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Approved", "Pending", "Flagged"] },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["vendor", "amount", "category", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile information"
    },
    "/users/{userId}/categoryBudgets/{budgetId}": {
      "schema": "CategoryBudget",
      "description": "Custom category budget limits and warning thresholds for a user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User financial transactions"
    }
  }
}
